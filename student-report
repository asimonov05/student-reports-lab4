#!/usr/bin/env bash
# Command-line entry point; all reports are read-only.
set -euo pipefail
if ((BASH_VERSINFO[0] < 4)); then
    printf 'Ошибка: требуется Bash 4 или новее.\n' >&2
    exit 2
fi
APP_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source-path=SCRIPTDIR
# shellcheck source=reports.sh
source "$APP_DIR/reports.sh"

usage() {
    cat <<'EOF'
Анализ данных студентов
Использование: student-report [--data КАТАЛОГ] КОМАНДА [ПАРАМЕТРЫ]
  groups                                      список групп
  subjects                                    список предметов
  tests ПРЕДМЕТ                               номера тестов предмета
  attendance ГРУППА ПРЕДМЕТ НАЧАЛО КОНЕЦ      лучшая посещаемость
  retakes ГРУППА ПРЕДМЕТ ТЕСТ                  больше всего пересдач
  first-pass ПРЕДМЕТ                          все тесты с первой попытки
  longest-names                               самые длинные фамилии
  yearly-best ПРЕДМЕТ ТЕСТ                     лучшие результаты по годам
Данные по умолчанию: data/labfiles-3-26 рядом со скриптами.
EOF
}

DATA_DIR=${STUDENT_DATA_DIR:-"$APP_DIR/data/labfiles-3-26"}
if [[ ${1:-} == --data ]]; then
    (($# >= 2)) || fail 'После --data укажите каталог данных.'
    DATA_DIR=$2
    shift 2
fi
case ${1:-} in
    -h|--help|help) usage; exit 0 ;;
    '') usage >&2; exit 2 ;;
esac
COMMAND=$1
shift
case $COMMAND in
    groups|subjects|longest-names) expected=0 ;;
    tests|first-pass) expected=1 ;;
    yearly-best) expected=2 ;;
    retakes) expected=3 ;;
    attendance) expected=4 ;;
    *) fail "Неизвестная команда: $COMMAND. См. --help." ;;
esac
(($# == expected)) || fail "Неверное число параметров команды $COMMAND. См. --help."
prepare_environment
case $COMMAND in
    groups) list_groups ;;
    subjects) list_subjects ;;
    tests) check_subject "$1"; list_tests "$1" ;;
    longest-names) run_report "$COMMAND" '' '' '' '' '' ;;
    first-pass) check_subject "$1"; run_report "$COMMAND" '' "$1" '' '' '' ;;
    yearly-best)
        check_subject "$1"; check_test "$1" "$2"
        run_report "$COMMAND" '' "$1" "$2" '' '' ;;
    retakes)
        check_group "$1"; check_subject "$2"; check_test "$2" "$3"
        run_report "$COMMAND" "$1" "$2" "$3" '' '' ;;
    attendance)
        check_group "$1"; check_subject "$2"
        if ! positive_integer "$3" || ! positive_integer "$4"; then
            fail 'Номера занятий должны быть положительными целыми числами (до 9 цифр).'
        fi
        ((10#$3 <= 10#$4)) || fail 'Начало диапазона не должно превышать конец.'
        run_report "$COMMAND" "$1" "$2" '' "$3" "$4" ;;
esac
