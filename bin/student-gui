#!/usr/bin/env bash
# Русский графический интерфейс к student-report. Обработка данных — в CLI.
set -u
set -o pipefail

usage() {
    printf 'Использование: %s [--data КАТАЛОГ]\n' "${0##*/}"
    printf 'Нужны Bash 4+, Zenity и графическая сессия Linux.\n'
}

if (( BASH_VERSINFO[0] < 4 )); then
    printf 'Ошибка: нужен Bash версии 4 или новее.\n' >&2
    exit 2
fi

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd) || exit 2
data_dir="$script_dir/../data/labfiles-3-26"
case $# in
    0) ;;
    1) if [[ $1 == --help || $1 == -h ]]; then usage; exit 0; fi
       usage >&2; exit 2 ;;
    2) if [[ $1 != --data || -z $2 ]]; then usage >&2; exit 2; fi
       data_dir=$2 ;;
    *) usage >&2; exit 2 ;;
esac

if ! command -v zenity >/dev/null 2>&1; then
    printf 'Ошибка: не установлен Zenity. Установите пакет zenity для вашего дистрибутива.\n' >&2
    exit 2
fi
if [[ -z ${DISPLAY:-} && -z ${WAYLAND_DISPLAY:-} ]]; then
    printf 'Ошибка: для Zenity нужна графическая сессия Linux (X11 или Wayland).\n' >&2
    exit 2
fi
if [[ ! -x $script_dir/student-report ]]; then
    printf 'Ошибка: не найден исполняемый файл %s/student-report.\n' "$script_dir" >&2
    exit 2
fi

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/student-gui.XXXXXX") || exit 2
trap 'rm -rf -- "$work_dir"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
report=("$script_dir/student-report" --data "$data_dir")

format_report() {
    local candidate charmap
    for candidate in C.UTF-8 C.utf8 en_US.UTF-8; do
        charmap=$(LC_ALL=$candidate locale charmap 2>/dev/null) || continue
        [[ $charmap == UTF-8 ]] || continue
        # Первый проход измеряет столбцы в символах; второй сохраняет заголовки
        # и параметры, заменяя табуляции таблицы пробелами нужной ширины.
        LC_ALL=$candidate gawk -F '\t' '
            ARGIND == 1 {
                if (index($0, "\t"))
                    for (i = 1; i <= NF; i++)
                        if (length($i) > width[i]) width[i] = length($i)
                next
            }
            !index($0, "\t") { print; next }
            {
                for (i = 1; i < NF; i++)
                    printf "%s%*s", $i, width[i] - length($i) + 2, ""
                print $NF
            }
        ' "$work_dir/raw-result" "$work_dir/raw-result"
        return $?
    done
    printf 'Ошибка: для отображения таблицы нужна локаль UTF-8.\n' >&2
    return 2
}

show_error() {
    printf '%s\n' "$1" >&2
    zenity --error --no-markup --title='Ошибка' --text="$1" \
        --ok-label='Понятно' --width=600 >/dev/null || :
}

# Списки получает CLI, поэтому интерфейс не знает устройства исходных файлов.
choose_value() {
    local title=$1 prompt=$2 column=$3 values selected status
    shift 3
    local -a rows=()
    if ! values=$("${report[@]}" "$@" 2>"$work_dir/error"); then
        show_error "$(cat -- "$work_dir/error")"
        return 2
    fi
    if [[ -z $values ]]; then
        show_error "Нет доступных значений: $column. Проверьте исходные данные."
        return 2
    fi
    mapfile -t rows <<< "$values"
    while :; do
        if selected=$(zenity --list --no-markup --title="$title" --text="$prompt" \
            --column="$column" --print-column=1 --ok-label='Выбрать' \
            --cancel-label='Отмена' --width=620 --height=420 -- "${rows[@]}"); then
            if [[ -n $selected ]]; then printf '%s\n' "$selected"; return 0; fi
            show_error "Выберите значение в списке «$column»."
        else
            status=$?
            if (( status != 1 )); then show_error 'Не удалось открыть окно выбора Zenity.'; fi
            return "$status"
        fi
    done
}

choose_group() {
    choose_value 'Выбор группы' 'Выберите номер группы.' 'Группа' groups
}
choose_subject() {
    choose_value 'Выбор предмета' 'Выберите предмет.' 'Предмет' subjects
}
choose_test() {
    choose_value 'Выбор теста' "Предмет: $1. Выберите номер теста." 'Номер теста' tests "$1"
}

choose_range() {
    local fields first last status
    while :; do
        if fields=$(zenity --forms --title='Период посещаемости' \
            --text='Границы диапазона включаются.' --separator='|' \
            --add-entry='Первое занятие' --add-entry='Последнее занятие' \
            --ok-label='Рассчитать' --cancel-label='Отмена' --width=460); then
            first=${fields%%|*}
            last=${fields#*|}
            if [[ $fields != *'|'* || ! $first =~ ^[0-9]+$ || ! $last =~ ^[0-9]+$ ||
                  ! $first =~ [1-9] || ! $last =~ [1-9] ]]; then
                show_error 'Заполните оба поля положительными целыми номерами занятий.'
                continue
            fi
            # Строковая проверка не переполняет арифметику при очень длинном вводе.
            while [[ $first == 0* ]]; do first=${first#0}; done
            while [[ $last == 0* ]]; do last=${last#0}; done
            if [[ ${#first} -gt 9 || ${#last} -gt 9 ]]; then
                show_error 'Номер занятия должен содержать не более 9 цифр.'
                continue
            fi
            if [[ ${#first} -gt ${#last} || ( ${#first} -eq ${#last} && $first > $last ) ]]; then
                show_error 'Номер первого занятия не должен превышать номер последнего.'
                continue
            fi
            printf '%s %s\n' "$first" "$last"
            return 0
        else
            status=$?
            if (( status != 1 )); then show_error 'Не удалось открыть окно ввода Zenity.'; fi
            return "$status"
        fi
    done
}

show_report() {
    local title=$1
    shift
    if "${report[@]}" "$@" >"$work_dir/raw-result" 2>"$work_dir/error"; then
        if ! format_report >"$work_dir/result" 2>"$work_dir/error"; then
            show_error "$(cat -- "$work_dir/error")"
            return
        fi
        # Один и тот же текст поступает в stdout и в прокручиваемое окно.
        cat -- "$work_dir/result"
        zenity --text-info --title="$title" --filename="$work_dir/result" \
            --font='Monospace 11' --width=900 --height=600 \
            --ok-label='Закрыть' --cancel-label='В главное меню' || :
    else
        show_error "$(cat -- "$work_dir/error")"
    fi
}

while :; do
    if choice=$(zenity --list --no-markup --title='Анализ данных студентов' \
        --text='Выберите функцию анализа.' --column='№' --column='Функция' \
        --print-column=1 --ok-label='Открыть' --cancel-label='Выход' \
        --width=1100 --height=400 \
        1 'Вывод списка студентов заданной группы с наилучшей посещаемостью за заданный период' \
        2 'Вывод имени студента с максимальным количеством пересдач теста с указанием их количества' \
        3 'Вывод списка студентов, сдавших все тесты с первой попытки' \
        4 'Вывод студентов с самыми длинными фамилиями' \
        5 'Вывод студентов с наилучшими результатами за каждый год сдачи теста'); then
        case $choice in
            1)
                group=$(choose_group) || continue
                subject=$(choose_subject) || continue
                range=$(choose_range) || continue
                read -r first last <<< "$range"
                show_report 'Наилучшая посещаемость' attendance "$group" "$subject" "$first" "$last"
                ;;
            2)
                group=$(choose_group) || continue
                subject=$(choose_subject) || continue
                test_number=$(choose_test "$subject") || continue
                show_report 'Максимальное количество пересдач' retakes "$group" "$subject" "$test_number"
                ;;
            3)
                subject=$(choose_subject) || continue
                show_report 'Все тесты с первой попытки' first-pass "$subject"
                ;;
            4) show_report 'Самые длинные фамилии' longest-names ;;
            5)
                subject=$(choose_subject) || continue
                test_number=$(choose_test "$subject") || continue
                show_report 'Наилучшие результаты по годам' yearly-best "$subject" "$test_number"
                ;;
            *) show_error 'Выберите одну из пяти функций.' ;;
        esac
    else
        status=$?
        if (( status == 1 )); then exit 0; fi
        printf 'Ошибка: не удалось открыть главное окно Zenity (код %s).\n' "$status" >&2
        exit 2
    fi
done
